# Copy this file to .env and fill in your own keys.
# The app works without any of these — each integration degrades gracefully
# to a well-designed fallback state (or local demo data) when a key is missing.

# OpenWeather (https://openweathermap.org/api) — powers the live weather card
VITE_OPENWEATHER_API_KEY=

# Unsplash (https://unsplash.com/developers) — powers dynamic destination photography
VITE_UNSPLASH_ACCESS_KEY=

# Pexels (https://www.pexels.com/api/) — alternative to Unsplash, used if set and Unsplash isn't
VITE_PEXELS_API_KEY=

# Google Gemini (https://ai.google.dev/) — powers the Travel Companion chat and itinerary generator
VITE_GEMINI_API_KEY=
